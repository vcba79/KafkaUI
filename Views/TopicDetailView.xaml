<UserControl x:Class="KafkaUI.Views.TopicDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KafkaUI"
             xmlns:views="clr-namespace:KafkaUI.Views">
    <UserControl.Resources>
        <ResourceDictionary Source="/Themes/DarkTheme.xaml"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource Background}">

        <!-- Main content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Breadcrumb + Produce button -->
                <RowDefinition Height="Auto"/>  <!-- Tabs -->
                <RowDefinition Height="*"/>     <!-- Tab content -->
            </Grid.RowDefinitions>

        <!-- ── Breadcrumb + Produce Message ── -->
        <Grid Grid.Row="0" Margin="24,20,24,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Command="{Binding BackCommand}" Padding="0">
                    <TextBlock Text="Topics" Foreground="{StaticResource Accent}"
                               FontSize="15" FontWeight="SemiBold"/>
                </Button>
                <TextBlock Text=" / " Foreground="{StaticResource TextSecondary}"
                           FontSize="15" VerticalAlignment="Center" Margin="4,0"/>
                <TextBlock Text="{Binding Topic.Name}" Foreground="{StaticResource TextPrimary}"
                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ProduceMessageCommand}"
                        Margin="0,0,8,0">
                    <TextBlock Text="Produce Message"/>
                </Button>
                <Button x:Name="MenuButton" Style="{StaticResource SecondaryButton}" Padding="10,8"
                        Click="MenuButton_Click">
                    <TextBlock Text="⋮" FontSize="16" Foreground="{StaticResource TextSecondary}"/>
                </Button>
                <Popup x:Name="ActionsPopup" PlacementTarget="{Binding ElementName=MenuButton}"
                       Placement="Bottom" HorizontalOffset="-280" VerticalOffset="4"
                       StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            CornerRadius="6" Width="300" Padding="16">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.3"/>
                        </Border.Effect>
                        <StackPanel>

                            <TextBlock Text="Edit settings" Foreground="{StaticResource TextPrimary}"
                                       FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Pay attention! This operation has especially important consequences."
                                       Foreground="{StaticResource TextSecondary}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    HorizontalAlignment="Left" Padding="0" Margin="0,0,0,2"
                                    Command="{Binding PurgeTopicCommand}"
                                    Click="ActionItem_Click">
                                <TextBlock Text="Clear messages" Foreground="{StaticResource Danger}" FontSize="13"/>
                            </Button>
                            <TextBlock Text="Clearing messages is only allowed for topics with DELETE policy"
                                       Foreground="{StaticResource TextSecondary}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    HorizontalAlignment="Left" Padding="0" Margin="0,0,0,16"
                                    Command="{Binding RecreateTopicCommand}"
                                    Click="ActionItem_Click">
                                <TextBlock Text="Recreate Topic" Foreground="{StaticResource Danger}" FontSize="13"/>
                            </Button>

                            <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    HorizontalAlignment="Left" Padding="0"
                                    Command="{Binding RemoveTopicCommand}"
                                    Click="ActionItem_Click">
                                <TextBlock Text="Remove Topic" Foreground="{StaticResource Danger}" FontSize="13"/>
                            </Button>

                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Grid>

        <!-- ── Tabs ── -->
        <Border Grid.Row="1" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,12,0,0">
            <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0"
                        Padding="24,0,0,0">
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource ModernTab}"/>
                </TabControl.Resources>
                <TabItem Header="Overview" IsSelected="True"/>
                <TabItem Header="Messages"/>
                <TabItem Header="Consumers"/>
                <TabItem Header="Settings"/>
                <TabItem Header="Statistics"/>
            </TabControl>
        </Border>

        <!-- ── Tab Content ── -->
        <Grid Grid.Row="2">

            <!-- Overview (shown when Overview tab selected) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource Background}"
                          Visibility="{Binding ElementName=MainTabs, Path=SelectedIndex,
                              Converter={x:Static local:IndexToVisibilityConverter.Instance},
                              ConverterParameter=0}">
                <StackPanel Margin="24,20,24,24">

                    <!-- Stat cards row -->
                    <Border Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            CornerRadius="8" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Partitions -->
                            <StackPanel Grid.Column="0" Margin="16,14">
                                <TextBlock Text="Partitions" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                <TextBlock Text="{Binding Topic.Partitions}" Foreground="{StaticResource TextPrimary}"
                                           FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource Border}" Margin="0,10"/>

                            <!-- Replication Factor -->
                            <StackPanel Grid.Column="2" Margin="16,14">
                                <TextBlock Text="Replication Factor" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                <TextBlock Text="{Binding Topic.ReplicationFactor}" Foreground="{StaticResource TextPrimary}"
                                           FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Rectangle Grid.Column="3" Width="1" Fill="{StaticResource Border}" Margin="0,10"/>

                            <!-- URP -->
                            <StackPanel Grid.Column="4" Margin="16,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="URP" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Success}"
                                             VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Topic.UnderReplicatedPartitions}"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Rectangle Grid.Column="5" Width="1" Fill="{StaticResource Border}" Margin="0,10"/>

                            <!-- In Sync Replicas -->
                            <StackPanel Grid.Column="6" Margin="16,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="In Sync Replicas" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Success}"
                                             VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Topic.InSyncReplicaCount}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Topic.ReplicationFactor, StringFormat=' of {0}'}"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="14" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                                </StackPanel>
                            </StackPanel>
                            <Rectangle Grid.Column="7" Width="1" Fill="{StaticResource Border}" Margin="0,10"/>

                            <!-- Type -->
                            <StackPanel Grid.Column="8" Margin="16,14">
                                <TextBlock Text="Type" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                <Border Margin="0,6,0,0" CornerRadius="3" Padding="8,3"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource SurfaceElevated}"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1">
                                    <TextBlock Text="{Binding Topic.TypeLabel}"
                                               Foreground="{StaticResource TextPrimary}" FontSize="12"/>
                                </Border>
                            </StackPanel>
                            <Rectangle Grid.Column="9" Width="1" Fill="{StaticResource Border}" Margin="0,10"/>

                            <!-- Segment Size -->
                            <StackPanel Grid.Column="10" Margin="16,14">
                                <TextBlock Text="Segment Size" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                <TextBlock Text="{Binding Topic.SizeFormatted}"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Rectangle Grid.Column="11" Width="1" Fill="{StaticResource Border}" Margin="0,10"/>

                            <!-- Segment Count -->
                            <StackPanel Grid.Column="12" Margin="16,14">
                                <TextBlock Text="Segment Count" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                <TextBlock Text="{Binding Topic.SegmentCount}"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Rectangle Grid.Column="13" Width="1" Fill="{StaticResource Border}" Margin="0,10"/>

                            <!-- Clean Up Policy -->
                            <StackPanel Grid.Column="14" Margin="16,14">
                                <TextBlock Text="Clean Up Policy" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                <Border Margin="0,6,0,0" CornerRadius="3" Padding="8,3"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource SurfaceElevated}"
                                        BorderBrush="{StaticResource Border}" BorderThickness="1">
                                    <TextBlock Text="{Binding Topic.CleanupPolicy}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="12"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Partitions table -->
                    <Border Style="{StaticResource Card}" Padding="0">
                        <DataGrid x:Name="PartitionsGrid"
                                  Style="{StaticResource DarkDataGrid}"
                                  ItemsSource="{Binding Topic.PartitionList}"
                                  Tag="{Binding}"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Partition ID" Binding="{Binding Id}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="12,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Replicas (count, accent colour) -->
                                <DataGridTemplateColumn Header="Replicas" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Replicas.Count}"
                                                       Foreground="{StaticResource Success}"
                                                       FontSize="13" VerticalAlignment="Center"
                                                       Margin="12,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="First Offset" Binding="{Binding OffsetEarliest}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="12,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Next Offset" Binding="{Binding OffsetLatest}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="12,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Message Count" Binding="{Binding MessageCount}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="12,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- ⋮ per-partition menu -->
                                <DataGridTemplateColumn Width="120" CanUserResize="False" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Background="Transparent" BorderThickness="0"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Cursor="Hand" Padding="6"
                                                    Tag="{Binding}"
                                                    Click="PartitionMenuButton_Click">
                                                <Button.ContextMenu>
                                                    <ContextMenu Tag="{Binding PlacementTarget.Tag,
                                                        RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="Clear Messages"
                                                                  Foreground="{StaticResource Danger}"
                                                                  Click="ClearPartitionMenuItem_Click"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                                <TextBlock Text="⋮" Foreground="{StaticResource TextSecondary}" FontSize="16"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Messages tab -->
            <Grid Margin="0,0,0,0"
                  Visibility="{Binding ElementName=MainTabs, Path=SelectedIndex,
                      Converter={x:Static local:IndexToVisibilityConverter.Instance},
                      ConverterParameter=1}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Filter bar -->
                    <RowDefinition Height="Auto"/>   <!-- Search + Add Filters + Stats -->
                    <RowDefinition Height="*"/>      <!-- Message table -->
                    <RowDefinition Height="Auto"/>   <!-- Back/Next pagination -->
                </Grid.RowDefinitions>

                <!-- Filter bar: Seek Type | Offset | Partitions | Key Serde | Value Serde | Clear all | Submit | Sort -->
                <Border Grid.Row="0" Background="{StaticResource Background}"
                        Padding="24,12,24,8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <!-- Seek Type label + dropdown -->
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Seek Type" Foreground="{StaticResource TextSecondary}"
                                           FontSize="11" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding SeekTypes}"
                                          SelectedItem="{Binding SeekType}"
                                          Width="100"
                                          Style="{StaticResource DarkComboBox}"/>
                            </StackPanel>

                            <!-- Offset value / Timestamp value (depends on Seek Type) -->
                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text=" " FontSize="11" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding OffsetValue, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource DarkTextBox}" Padding="8,5"
                                         Visibility="{Binding IsOffsetSeek, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
                                <DatePicker SelectedDate="{Binding TimestampValue}"
                                            Style="{StaticResource DarkDatePicker}"
                                            Visibility="{Binding IsTimestampSeek, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
                            </StackPanel>

                            <!-- Partitions -->
                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Partitions" Foreground="{StaticResource TextSecondary}"
                                           FontSize="11" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding PartitionItems}"
                                          SelectedItem="{Binding SelectedPartitionItem}"
                                          Style="{StaticResource DarkComboBox}"/>
                            </StackPanel>

                            <!-- Key Serde -->
                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="Key Serde" Foreground="{StaticResource TextSecondary}"
                                           FontSize="11" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding SerdeTypes}"
                                          SelectedItem="{Binding KeySerde}"
                                          Style="{StaticResource DarkComboBox}"/>
                            </StackPanel>

                            <!-- Value Serde -->
                            <StackPanel Grid.Column="4" Margin="0,0,12,0">
                                <TextBlock Text="Value Serde" Foreground="{StaticResource TextSecondary}"
                                           FontSize="11" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding SerdeTypes}"
                                          SelectedItem="{Binding ValueSerde}"
                                          Style="{StaticResource DarkComboBox}"/>
                            </StackPanel>

                            <!-- Clear all -->
                            <Button Grid.Column="5" Content="Clear all"
                                    Command="{Binding ClearMessagesCommand}"
                                    VerticalAlignment="Bottom" Margin="0,0,8,0"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource TextSecondary}"
                                    FontSize="12" Padding="0,5" Cursor="Hand"/>

                            <!-- Submit -->
                            <Button Grid.Column="6" Content="Submit"
                                    Command="{Binding LoadMessagesCommand}"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="20,5"/>

                            <!-- Sort order -->
                            <StackPanel Grid.Column="8" Margin="0,0,0,0">
                                <TextBlock Text=" " FontSize="11" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding SortOrders}"
                                          SelectedItem="{Binding SortOrder}"
                                          Style="{StaticResource DarkComboBox}"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- Search + Add Filters + Stats row -->
                <Grid Grid.Row="1" Margin="24,0,24,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Search box -->
                        <Border BorderBrush="{StaticResource Border}" BorderThickness="1"
                                CornerRadius="4" Background="{StaticResource Surface}"
                                Padding="8,5" Width="220">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TextPrimary}"
                                         FontSize="12" VerticalAlignment="Center" MinWidth="160"/>
                            </StackPanel>
                        </Border>

                        <!-- Add Filters -->
                        <Button Margin="12,0,0,0" Padding="12,6" FontSize="12"
                                Style="{StaticResource SecondaryButton}">
                            <TextBlock Text="+ Add Filters"/>
                        </Button>
                    </StackPanel>

                    <!-- Stats (shown after load) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasStats, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                        <TextBlock Text="DONE" Foreground="{StaticResource TextSecondary}"
                                   FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Text="⏱" Foreground="{StaticResource TextSecondary}"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ElapsedDisplay}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="12" Margin="4,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Text="↓" Foreground="{StaticResource TextSecondary}"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding BytesDisplay}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="12" Margin="4,0,16,0" VerticalAlignment="Center"/>
                        <TextBlock Text="📄" Foreground="{StaticResource TextSecondary}"
                                   FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ConsumedDisplay}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Message table -->
                <Border Grid.Row="2" Margin="24,0,24,0" Style="{StaticResource Card}" Padding="0">
                    <DataGrid Style="{StaticResource DarkDataGrid}"
                              ItemsSource="{Binding FilteredMessages}"
                              SelectedItem="{Binding SelectedMessage}"
                              IsReadOnly="True" CanUserResizeRows="False">
                        <DataGrid.Columns>

                            <!-- Expand toggle -->
                            <DataGridTemplateColumn Width="40" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="22" Height="22" CornerRadius="3"
                                                Background="{StaticResource Accent}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Cursor="Hand">
                                            <TextBlock Text="+" Foreground="White" FontSize="14"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Offset -->
                            <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Partition -->
                            <DataGridTextColumn Header="Partition" Binding="{Binding Partition}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Timestamp -->
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding TimestampFormatted}" Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Key -->
                            <DataGridTemplateColumn Width="*" MinWidth="120">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Key" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                            <TextBlock Text=" Preview" Foreground="{StaticResource Accent}" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding KeyDisplay}"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Center" Margin="12,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Value -->
                            <DataGridTemplateColumn Width="2*" MinWidth="200">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Value" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                            <TextBlock Text=" Preview" Foreground="{StaticResource Accent}" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ValuePreview}"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Center" Margin="12,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ⋮ -->
                            <DataGridTemplateColumn Width="48" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Background="Transparent" BorderThickness="0"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Cursor="Hand" Padding="6">
                                            <TextBlock Text="⋮" Foreground="{StaticResource TextSecondary}" FontSize="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Back / Next pagination -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="24,12,24,16">
                    <Button Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0">
                        <TextBlock Text="← Back"/>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Padding="12,6">
                        <TextBlock Text="Next →"/>
                    </Button>
                </StackPanel>

            </Grid>

            <!-- Consumers tab -->
            <Grid Margin="24,16,24,24"
                  Visibility="{Binding ElementName=MainTabs, Path=SelectedIndex,
                      Converter={x:Static local:IndexToVisibilityConverter.Instance},
                      ConverterParameter=2}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search -->
                <TextBox Grid.Row="0" Style="{StaticResource DarkTextBox}"
                         Text="{Binding ConsumerSearchText, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Search by Consumer Name"
                         Width="320" HorizontalAlignment="Left"
                         Margin="0,0,0,16"/>

                <!-- Table or empty state -->
                <Grid Grid.Row="1">
                    <Border Style="{StaticResource Card}" Padding="0"
                            Visibility="{Binding HasConsumerGroups, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                        <DataGrid Style="{StaticResource DarkDataGrid}"
                                  ItemsSource="{Binding FilteredConsumerGroups}"
                                  IsReadOnly="True" CanUserResizeRows="False">
                            <DataGrid.Columns>

                                <DataGridTemplateColumn Header="Consumer Group ID" Width="*" MinWidth="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding GroupId}"
                                                       Foreground="{StaticResource Accent}"
                                                       FontSize="13" Cursor="Hand"
                                                       VerticalAlignment="Center" Margin="12,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Active Consumers" Binding="{Binding MemberCount}" Width="160">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="12,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Consumer Lag" Binding="{Binding TotalLag}" Width="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="12,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Coordinator" Binding="{Binding Coordinator}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="12,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="State" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border VerticalAlignment="Center" HorizontalAlignment="Left"
                                                    CornerRadius="3" Padding="8,3" Margin="12,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#2D2200"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Stable">
                                                                <Setter Property="Background" Value="#2D2200"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Empty">
                                                                <Setter Property="Background" Value="#22263A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Dead">
                                                                <Setter Property="Background" Value="#2D1010"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding State}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Stable">
                                                                    <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Empty">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Dead">
                                                                    <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Empty state -->
                    <Grid Visibility="{Binding HasConsumerGroups, Converter={x:Static local:InverseBoolToVisibilityConverter.Instance}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Column headers shown even when empty, matching original -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Consumer Group ID" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Active Consumers" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="Consumer Lag" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Coordinator" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="4" Text="State" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Text="No active consumer groups"
                                   Foreground="{StaticResource TextPrimary}" FontSize="13"
                                   HorizontalAlignment="Center" Margin="0,20,0,0"/>
                    </Grid>
                </Grid>
            </Grid>
            <Border Margin="24,16,24,24" Style="{StaticResource Card}" Padding="0"
                    Visibility="{Binding ElementName=MainTabs, Path=SelectedIndex,
                        Converter={x:Static local:IndexToVisibilityConverter.Instance},
                        ConverterParameter=3}">
                <DataGrid Style="{StaticResource DarkDataGrid}"
                          ItemsSource="{Binding Topic.ConfigEntries}" IsReadOnly="True"
                          CanUserResizeRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="320">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="12,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="12,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Default Value" Binding="{Binding DefaultValue}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="12,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <!-- Statistics tab -->
            <Grid Margin="24,16,24,24"
                  Visibility="{Binding ElementName=MainTabs, Path=SelectedIndex,
                      Converter={x:Static local:IndexToVisibilityConverter.Instance},
                      ConverterParameter=4}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Analyzed-at timestamp + Restart button -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="{Binding Statistics.AnalyzedAtDisplay}"
                               Foreground="{StaticResource TextSecondary}" FontSize="12"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,160,0"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding RestartAnalysisCommand}"
                            HorizontalAlignment="Right" Padding="16,7">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Restart Analysis"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                            <Setter Property="Text" Value="Analyzing…"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Grid>

                <!-- Messages stat card -->
                <StackPanel Grid.Row="1" Margin="0,0,0,20">
                    <TextBlock Text="Messages" Foreground="{StaticResource TextPrimary}"
                               FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Border Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel Orientation="Horizontal">

                            <StackPanel Margin="16,14">
                                <TextBlock Text="Total number" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                <TextBlock Text="{Binding Statistics.TotalMessages}"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Rectangle Width="1" Fill="{StaticResource Border}" Margin="0,10"/>

                            <StackPanel Margin="16,14">
                                <TextBlock Text="Offsets min-max" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                <TextBlock Text="{Binding Statistics.OffsetsDisplay}"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="14" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Rectangle Width="1" Fill="{StaticResource Border}" Margin="0,10"/>

                            <StackPanel Margin="16,14">
                                <TextBlock Text="Timestamp min-max" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                <TextBlock Text="{Binding Statistics.TimestampDisplay}"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="13" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Rectangle Width="1" Fill="{StaticResource Border}" Margin="0,10"/>

                            <StackPanel Margin="16,14">
                                <TextBlock Text="Null keys" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                <TextBlock Text="{Binding Statistics.NullKeys}"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Rectangle Width="1" Fill="{StaticResource Border}" Margin="0,10"/>

                            <StackPanel Margin="16,14">
                                <TextBlock Text="Unique keys" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                <TextBlock Text="{Binding Statistics.UniqueKeys}"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Rectangle Width="1" Fill="{StaticResource Border}" Margin="0,10"/>

                            <StackPanel Margin="16,14">
                                <TextBlock Text="Null values" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                <TextBlock Text="{Binding Statistics.NullValues}"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Rectangle Width="1" Fill="{StaticResource Border}" Margin="0,10"/>

                            <StackPanel Margin="16,14">
                                <TextBlock Text="Unique values" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                <TextBlock Text="{Binding Statistics.UniqueValues}"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Per-partition table -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <DataGrid Style="{StaticResource DarkDataGrid}"
                                  ItemsSource="{Binding Statistics.Partitions}"
                                  IsReadOnly="True" CanUserResizeRows="False"
                                  Visibility="{Binding Statistics, Converter={x:Static local:NotNullToVisibilityConverter.Instance}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Partition ID" Binding="{Binding PartitionId}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="12,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Total Messages" Binding="{Binding TotalMessages}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="12,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Min Offset" Binding="{Binding MinOffset}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="12,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Max Offset" Binding="{Binding MaxOffset}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="12,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty state -->
                        <TextBlock Text="No rows found"
                                   Foreground="{StaticResource TextPrimary}" FontSize="13"
                                   HorizontalAlignment="Center" Margin="0,20,0,0"
                                   Visibility="{Binding Statistics, Converter={x:Static local:InverseBoolToVisibilityConverter.Instance}}"/>
                    </Grid>
                </Border>

            </Grid>
        </Grid><!-- end Grid Row 2 -->
        </Grid><!-- end main content Grid -->

        <!-- Produce Message inline page overlay -->
        <ContentControl Content="{Binding ProduceVM}"
                        Visibility="{Binding ProduceVM, Converter={x:Static local:NotNullToVisibilityConverter.Instance}}">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <views:ProduceMessageView/>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

    </Grid>
</UserControl>