<UserControl x:Class="KafkaUI.Views.BrokerDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KafkaUI">
    <UserControl.Resources>
        <ResourceDictionary Source="/Themes/DarkTheme.xaml"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Breadcrumb -->
            <RowDefinition Height="Auto"/>  <!-- Stat cards -->
            <RowDefinition Height="Auto"/>  <!-- Tabs -->
            <RowDefinition Height="*"/>     <!-- Tab content -->
        </Grid.RowDefinitions>

        <!-- Breadcrumb -->
        <Grid Grid.Row="0" Margin="24,20,24,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Command="{Binding BackCommand}" Padding="0">
                    <TextBlock Text="Brokers" Foreground="{StaticResource Accent}"
                               FontSize="15" FontWeight="SemiBold"/>
                </Button>
                <TextBlock Text=" / " Foreground="{StaticResource TextSecondary}"
                           FontSize="15" VerticalAlignment="Center" Margin="4,0"/>
                <TextBlock Text="{Binding Detail.Id, StringFormat='Broker {0}'}"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Stat cards (Port + Host only — Segment Size/Count removed: relied on fabricated
             log-directory data that Confluent.Kafka's .NET client cannot actually provide) -->
        <Border Grid.Row="1" Margin="24,0,24,20"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="6">
            <StackPanel Orientation="Horizontal">

                <!-- Port -->
                <StackPanel Margin="16,14">
                    <TextBlock Text="Port" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                    <TextBlock Text="{Binding Detail.Port}"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
                <Rectangle Width="1" Fill="{StaticResource Border}" Margin="0,10"/>

                <!-- Host -->
                <StackPanel Margin="16,14">
                    <TextBlock Text="Host" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                    <TextBlock Text="{Binding Detail.Host}"
                               Foreground="{StaticResource Accent}"
                               FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Tabs (Log directories tab removed — see note above) -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <TabControl x:Name="BrokerTabs" Background="Transparent" BorderThickness="0"
                        Padding="24,0,0,0">
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource ModernTab}"/>
                </TabControl.Resources>
                <TabItem Header="Configs" IsSelected="True"/>
            </TabControl>
        </Border>

        <!-- Tab content -->
        <Grid Grid.Row="3">

            <!-- Configs -->
            <Grid Margin="24,16,24,24"
                  Visibility="{Binding ElementName=BrokerTabs, Path=SelectedIndex,
                      Converter={x:Static local:IndexToVisibilityConverter.Instance},
                      ConverterParameter=0}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                <DataGrid Style="{StaticResource DarkDataGrid}"
                          ItemsSource="{Binding PagedConfigEntries}"
                          IsReadOnly="True" CanUserResizeRows="False"
                          x:Name="ConfigGrid">
                    <DataGrid.Columns>

                        <!-- Key -->
                        <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="300">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="12,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Value (display or edit) -->
                        <DataGridTemplateColumn Header="Value" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <!-- Display mode -->
                                        <TextBlock Text="{Binding Value}"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   VerticalAlignment="Center" Margin="12,0"
                                                   Visibility="{Binding IsNotEditing, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
                                        <!-- Edit mode -->
                                        <TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DarkTextBox}"
                                                 Margin="8,4" Padding="6,3"
                                                 Visibility="{Binding IsEditing, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="" Width="140" CanUserResize="False" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">

                                        <!-- Edit button (shown when not editing) -->
                                        <Button Margin="0,0,4,0" Padding="8,4" FontSize="11"
                                                Style="{StaticResource SecondaryButton}"
                                                Visibility="{Binding IsNotEditing, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
                                                Command="{Binding DataContext.EditConfigCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="Edit"/>
                                        </Button>

                                        <!-- Save button (shown when editing) -->
                                        <Button Margin="0,0,4,0" Padding="8,4" FontSize="11"
                                                Style="{StaticResource PrimaryButton}"
                                                Visibility="{Binding IsEditing, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
                                                Command="{Binding DataContext.SaveConfigCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="Save"/>
                                        </Button>

                                        <!-- Cancel button (shown when editing) -->
                                        <Button Padding="8,4" FontSize="11"
                                                Style="{StaticResource SecondaryButton}"
                                                Visibility="{Binding IsEditing, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
                                                Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="Cancel"/>
                                        </Button>

                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
                </Border>

                <!-- Pagination bar -->
                <StackPanel Grid.Row="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,12,0,0">
                    <TextBlock Text="{Binding PageDisplay}" Foreground="{StaticResource TextSecondary}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0"
                            Command="{Binding PreviousPageCommand}">
                        <TextBlock Text="← Previous"/>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Padding="12,6"
                            Command="{Binding NextPageCommand}">
                        <TextBlock Text="Next →"/>
                    </Button>
                </StackPanel>

            </Grid>

        </Grid>
    </Grid>
</UserControl>
