<Window x:Class="KafkaUI.Views.ViewClustersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KafkaUI"
        Title="Clusters" Width="580" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1A1D27"
        FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary Source="/Themes/DarkTheme.xaml"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Kafka Clusters" Foreground="#E8EAF6" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Double-click a cluster to connect, or use the action buttons." Foreground="#8B93C4" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}"
                    Padding="12,7">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="+" FontSize="16" FontWeight="Bold" Margin="0,-1,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Add Cluster" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Cluster list -->
        <Border Grid.Row="1"
                BorderBrush="#2D3148" BorderThickness="1" CornerRadius="8"
                Background="#12151F">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Clusters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RowBorder"
                                    Background="Transparent"
                                    BorderBrush="#2D3148" BorderThickness="0,0,0,1"
                                    Padding="16,12"
                                    Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                  Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status dot -->
                                    <Ellipse Grid.Column="0" Width="10" Height="10"
                                             Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="#2DD4A5"/>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <!-- Name + servers -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Foreground="#E8EAF6"
                                                       FontSize="14" FontWeight="SemiBold"/>
                                            <!-- Default badge -->
                                            <Border Background="#1E3A5F" CornerRadius="3"
                                                    Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsDefault, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                                <TextBlock Text="DEFAULT" Foreground="#4F9EF7"
                                                           FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding BootstrapServers}"
                                                   Foreground="#8B93C4" FontSize="12" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Edit button -->
                                    <Button Grid.Column="2"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="10,5" Margin="0,0,6,0" FontSize="14"
                                            ToolTip="Edit cluster">
                                        <TextBlock Text="✎"/>
                                    </Button>

                                    <!-- Delete button -->
                                    <Button Grid.Column="3"
                                            Style="{StaticResource DangerButton}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Padding="10,5" FontSize="12"
                                            ToolTip="Delete cluster">
                                        <TextBlock Text="✕"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <!-- Empty state -->
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Clusters.Count}" Value="0">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Margin="0,40">
                                                    <TextBlock Text="No clusters saved yet."
                                                               Foreground="#4A5180" FontSize="14"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Click '+ Add Cluster' to get started."
                                                               Foreground="#4A5180" FontSize="12"
                                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="2"
                   Text="{Binding Clusters.Count, StringFormat={}{0} cluster(s) saved}"
                   Foreground="#4A5180" FontSize="12"
                   VerticalAlignment="Center" Margin="0,12,0,0"/>
    </Grid>
</Window>
