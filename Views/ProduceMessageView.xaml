<UserControl x:Class="KafkaUI.Views.ProduceMessageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KafkaUI">
    <UserControl.Resources>
        <ResourceDictionary Source="/Themes/DarkTheme.xaml"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource Background}">
        <StackPanel Margin="24,24,24,40" MaxWidth="640" HorizontalAlignment="Left">

            <!-- Header: title + Close button -->
            <Grid Margin="0,0,0,24">
                <TextBlock Text="Produce Message" Foreground="{StaticResource TextPrimary}"
                           FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}" Padding="20,6">
                    <TextBlock Text="Close"/>
                </Button>
            </Grid>

            <!-- Partition -->
            <TextBlock Text="Partition" Foreground="{StaticResource TextSecondary}"
                       FontSize="12" Margin="0,0,0,6"/>
            <ComboBox ItemsSource="{Binding PartitionOptions}"
                      SelectedItem="{Binding PartitionText}"
                      Style="{StaticResource DarkComboBox}"
                      Width="200" HorizontalAlignment="Left"
                      Margin="0,0,0,20"/>

            <!-- Key Serde + Value Serde -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Key Serde" Foreground="{StaticResource TextSecondary}"
                               FontSize="12" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding SerdeOptions}"
                              SelectedItem="{Binding KeySerde}"
                              Style="{StaticResource DarkComboBox}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Value Serde" Foreground="{StaticResource TextSecondary}"
                               FontSize="12" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding SerdeOptions}"
                              SelectedItem="{Binding ValueSerde}"
                              Style="{StaticResource DarkComboBox}"/>
                </StackPanel>
            </Grid>

            <!-- Keep contents toggle -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <CheckBox IsChecked="{Binding KeepContents}" VerticalAlignment="Center">
                    <CheckBox.Template>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Pill" Width="36" Height="20" CornerRadius="10"
                                    Background="{StaticResource Border}" Cursor="Hand">
                                <Border x:Name="Thumb" Width="14" Height="14" CornerRadius="7"
                                        Background="{StaticResource TextSecondary}"
                                        HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource Accent}"/>
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Thumb" Property="Background" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </CheckBox.Template>
                </CheckBox>
                <TextBlock Text="Keep contents" Foreground="{StaticResource TextSecondary}"
                           FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- Key editor -->
            <TextBlock Text="Key" Foreground="{StaticResource TextSecondary}"
                       FontSize="12" Margin="0,0,0,6"/>
            <Border BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="4" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="1" Foreground="{StaticResource TextSecondary}"
                               FontSize="12" FontFamily="Consolas"
                               Background="{StaticResource SurfaceElevated}"
                               Padding="8,6" VerticalAlignment="Top"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource Surface}"
                             Foreground="{StaticResource TextPrimary}"
                             BorderThickness="0" Padding="8,6"
                             FontFamily="Consolas, Courier New" FontSize="12"
                             AcceptsReturn="True" MinHeight="32"/>
                </Grid>
            </Border>

            <!-- Value editor -->
            <TextBlock Text="Value" Foreground="{StaticResource TextSecondary}"
                       FontSize="12" Margin="0,0,0,6"/>
            <Border BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="4" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="1" Foreground="{StaticResource TextSecondary}"
                               FontSize="12" FontFamily="Consolas"
                               Background="{StaticResource SurfaceElevated}"
                               Padding="8,6" VerticalAlignment="Top"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource Surface}"
                             Foreground="{StaticResource TextPrimary}"
                             BorderThickness="0" Padding="8,6"
                             FontFamily="Consolas, Courier New" FontSize="12"
                             AcceptsReturn="True" MinHeight="180"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>

            <!-- Headers editor -->
            <TextBlock Text="Headers" Foreground="{StaticResource TextSecondary}"
                       FontSize="12" Margin="0,0,0,6"/>
            <Border BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="4" Margin="0,0,0,28">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="1" Foreground="{StaticResource TextSecondary}"
                               FontSize="12" FontFamily="Consolas"
                               Background="{StaticResource SurfaceElevated}"
                               Padding="8,6" VerticalAlignment="Top"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding HeadersText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource Surface}"
                             Foreground="{StaticResource TextPrimary}"
                             BorderThickness="0" Padding="8,6"
                             FontFamily="Consolas, Courier New" FontSize="12"
                             AcceptsReturn="True" MinHeight="40"/>
                </Grid>
            </Border>

            <!-- Produce button -->
            <Button Style="{StaticResource PrimaryButton}"
                    Command="{Binding ProduceCommand}"
                    HorizontalAlignment="Left" Padding="20,8">
                <TextBlock Text="Produce Message" FontSize="13"/>
            </Button>

        </StackPanel>
    </ScrollViewer>
</UserControl>
