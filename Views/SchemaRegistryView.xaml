<UserControl x:Class="KafkaUI.Views.SchemaRegistryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KafkaUI"
             xmlns:models="clr-namespace:KafkaUI.Models">

    <UserControl.Resources>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1E90FF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- NOT CONFIGURED -->
        <TextBlock Text="{Binding StatusMessage}"
                   Visibility="{Binding IsConfigured, Converter={x:Static local:InverseBoolToVisibilityConverter.Instance}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#888" FontSize="14"/>

        <!-- MAIN CONTENT -->
        <Grid Visibility="{Binding IsConfigured, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <ToolBar Grid.Row="0" Background="#2D2D2D" BorderThickness="0,0,0,1" BorderBrush="#3A3A3A">
                <Button Command="{Binding RefreshCommand}" ToolTip="Refresh" Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↻" FontSize="14" Margin="0,0,4,0"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <Button Command="{Binding OpenCreateCommand}" ToolTip="Register new schema" Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontSize="14" Margin="0,0,4,0" Foreground="#4CAF50"/>
                        <TextBlock Text="Register Schema"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenEditCommand}" ToolTip="Add new version" Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✎" FontSize="13" Margin="0,0,4,0" Foreground="#2196F3"/>
                        <TextBlock Text="New Version"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeleteSubjectCommand}" ToolTip="Delete subject" Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✕" FontSize="13" Margin="0,0,4,0" Foreground="#F44336"/>
                        <TextBlock Text="Delete"/>
                    </StackPanel>
                </Button>
                <Separator/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Width="220" Margin="4,0"
                         Background="#3A3A3A" Foreground="#DDD"
                         BorderBrush="#555" Padding="6,3"/>
                <TextBlock Text="Loading…" Foreground="#AAA" FontStyle="Italic"
                           Visibility="{Binding IsLoading, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
                           Margin="8,0"/>
            </ToolBar>

            <!-- Three-column layout -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" MinWidth="180"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="260" MinWidth="200"/>
                </Grid.ColumnDefinitions>

                <!-- Col 0: Subject list -->
                <DockPanel Grid.Column="0" Background="#1E1E1E">
                    <TextBlock DockPanel.Dock="Top" Text="SUBJECTS"
                               Foreground="#666" FontSize="11" FontWeight="Bold"
                               Margin="10,8,10,4"/>
                    <ListBox ItemsSource="{Binding FilteredSubjects}"
                             SelectedItem="{Binding SelectedSubject}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:SchemaSubject}">
                                <Grid Margin="0,3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Foreground="#DDD"
                                                   FontSize="13" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="180"/>
                                        <TextBlock Style="{StaticResource BadgeText}"
                                                   Text="{Binding SchemaType}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,1,0,0">
                                        <TextBlock Text="v" Foreground="#666" FontSize="11"/>
                                        <TextBlock Text="{Binding LatestVersion}" Foreground="#888" FontSize="11"/>
                                        <TextBlock Text=" · " Foreground="#555" FontSize="11"/>
                                        <TextBlock Text="{Binding Compatibility}" Foreground="#666" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#CCC"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2A4060"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A2A2A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#333" ShowsPreview="True"/>

                <!-- Col 2: Schema detail -->
                <Grid Grid.Column="2" Background="#1A1A1A">
                    <TextBlock Text="← Select a subject to view its schema"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#555" FontSize="14"
                               Visibility="{Binding HasSelection, Converter={x:Static local:InverseBoolToVisibilityConverter.Instance}}"/>

                    <DockPanel Visibility="{Binding HasSelection, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">

                        <Border DockPanel.Dock="Top" Background="#252525"
                                BorderBrush="#333" BorderThickness="0,0,0,1" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedSubject.Name}"
                                           Foreground="#EEE" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource BadgeText}"
                                           Text="{Binding SelectedSubject.SchemaType}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text=" · ID " Foreground="#666" VerticalAlignment="Center" FontSize="12" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding SelectedSubject.SchemaId}"
                                           Foreground="#999" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border DockPanel.Dock="Bottom" Height="140"
                                Background="#1E1E1E" BorderBrush="#333" BorderThickness="0,1,0,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,6,10,4">
                                    <TextBlock Text="VERSION HISTORY" Foreground="#666" FontSize="11" FontWeight="Bold"/>
                                    <Button Command="{Binding DeleteVersionCommand}"
                                            ToolTip="Delete selected version"
                                            Margin="12,0,0,0" Padding="6,2" FontSize="11">
                                        <TextBlock Text="✕ Delete version" Foreground="#F44336"/>
                                    </Button>
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding Versions}"
                                          SelectedItem="{Binding SelectedVersion}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          Background="Transparent" RowBackground="#1E1E1E"
                                          AlternatingRowBackground="#222"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#2A2A2A"
                                          BorderThickness="0" Foreground="#CCC" FontSize="12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="70"/>
                                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding SchemaType}" Width="80"/>
                                        <DataGridTextColumn Header="Schema (preview)" Binding="{Binding Schema}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8,10,4">
                                <TextBlock Text="LATEST SCHEMA" Foreground="#666" FontSize="11" FontWeight="Bold"/>
                                <Button Command="{Binding CopySchemaCommand}"
                                        Margin="12,0,0,0" Padding="6,2" FontSize="11"
                                        ToolTip="Copy schema to clipboard">
                                    <TextBlock Text="⎘ Copy"/>
                                </Button>
                            </StackPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                                <TextBox Text="{Binding SelectedSubject.LatestSchema, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontFamily="Consolas, Courier New" FontSize="13"
                                         Background="#1A1A1A" Foreground="#CE9178"
                                         BorderThickness="0" Padding="12"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                            </ScrollViewer>
                        </DockPanel>
                    </DockPanel>
                </Grid>

                <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="#333" ShowsPreview="True"/>

                <!-- Col 4: Compatibility + Editor -->
                <DockPanel Grid.Column="4" Background="#1E1E1E">

                    <Border DockPanel.Dock="Top" Padding="12,10"
                            BorderBrush="#333" BorderThickness="0,0,0,1"
                            Visibility="{Binding HasSelection, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                        <StackPanel>
                            <TextBlock Text="COMPATIBILITY" Foreground="#666"
                                       FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding CompatibilityLevels}"
                                      SelectedItem="{Binding SelectedCompatibility}"
                                      Background="#2D2D2D" Foreground="#CCC" BorderBrush="#555"/>
                            <Button Content="Apply" Command="{Binding SaveCompatibilityCommand}"
                                    Margin="0,8,0,0" Padding="0,6"
                                    Background="#2A4060" Foreground="#EEE" BorderThickness="0"/>
                        </StackPanel>
                    </Border>

                    <DockPanel Visibility="{Binding ShowEditor, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                        <Border DockPanel.Dock="Top" Padding="12,10"
                                BorderBrush="#333" BorderThickness="0,0,0,1" Background="#252525">
                            <StackPanel>
                                <TextBlock Text="{Binding EditorTitle}" Foreground="#EEE"
                                           FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBlock Text="Subject name" Foreground="#888" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding EditorSubjectName, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsEditing, Converter={x:Static local:InverseBoolConverter.Instance}}"
                                         Background="#2D2D2D" Foreground="#DDD"
                                         BorderBrush="#555" Padding="6,4"/>
                                <TextBlock Text="Schema type" Foreground="#888" FontSize="11" Margin="0,8,0,3"/>
                                <ComboBox ItemsSource="{Binding SchemaTypes}"
                                          SelectedItem="{Binding EditorSchemaType}"
                                          Background="#2D2D2D" Foreground="#CCC" BorderBrush="#555"/>
                                <TextBlock Text="Schema" Foreground="#888" FontSize="11" Margin="0,8,0,3"/>
                                <Button Content="Format JSON" Command="{Binding FormatSchemaCommand}"
                                        Margin="0,0,0,4" Padding="0,4" FontSize="11"
                                        Background="#2D2D2D" Foreground="#AAA" BorderBrush="#444"/>
                            </StackPanel>
                        </Border>

                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                    Margin="10,8" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding CancelEditorCommand}"
                                    Padding="16,6" Margin="0,0,8,0"
                                    Background="#333" Foreground="#CCC" BorderThickness="0"/>
                            <Button Content="Register" Command="{Binding SaveSchemaCommand}"
                                    Padding="16,6" Background="#1976D2" Foreground="White" BorderThickness="0"/>
                        </StackPanel>

                        <TextBox Text="{Binding EditorSchema, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Consolas, Courier New" FontSize="12"
                                 Background="#1A1A1A" Foreground="#CE9178"
                                 BorderThickness="0" Padding="10"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"/>
                    </DockPanel>

                    <TextBlock Text="Select a subject or register a new schema"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#444" FontSize="12" TextWrapping="Wrap" Margin="20"
                               Visibility="{Binding ShowEditor, Converter={x:Static local:InverseBoolToVisibilityConverter.Instance}}"/>
                </DockPanel>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="#252525"
                    BorderBrush="#333" BorderThickness="0,1,0,0" Padding="10,4">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#888" FontSize="11"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
