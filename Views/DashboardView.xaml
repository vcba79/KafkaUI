<UserControl x:Class="KafkaUI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:KafkaUI">
    <UserControl.Resources>
        <ResourceDictionary Source="/Themes/DarkTheme.xaml"/>
    </UserControl.Resources>

    <ScrollViewer Background="{StaticResource Background}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,24,24,24">

            <!-- Title -->
            <TextBlock Text="Dashboard" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

            <!-- Online / Offline summary cards -->
            <Border Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="6" Margin="0,0,0,20" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">

                    <StackPanel Margin="16,14">
                        <Border Background="#1A3A2A" CornerRadius="10" Padding="8,3"
                                HorizontalAlignment="Left" Margin="0,0,0,6">
                            <TextBlock Text="Online" Foreground="#2DD4A5" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding OnlineCount}" Foreground="{StaticResource TextPrimary}"
                                       FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text=" clusters" Foreground="{StaticResource TextSecondary}" FontSize="13"
                                       VerticalAlignment="Bottom" Margin="4,0,0,1"/>
                        </StackPanel>
                    </StackPanel>
                    <Rectangle Width="1" Fill="{StaticResource Border}" Margin="0,10"/>

                    <StackPanel Margin="16,14">
                        <Border Background="{StaticResource SurfaceElevated}" CornerRadius="10" Padding="8,3"
                                HorizontalAlignment="Left" Margin="0,0,0,6">
                            <TextBlock Text="Offline" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding OfflineCount}" Foreground="{StaticResource TextPrimary}"
                                       FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text=" clusters" Foreground="{StaticResource TextSecondary}" FontSize="13"
                                       VerticalAlignment="Bottom" Margin="4,0,0,1"/>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Only offline clusters toggle -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <CheckBox IsChecked="{Binding OnlyOfflineClusters}" VerticalAlignment="Center">
                    <CheckBox.Template>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="Pill" Width="42" Height="22" CornerRadius="11"
                                    Background="{StaticResource Border}" Cursor="Hand">
                                <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="8"
                                        Background="{StaticResource TextSecondary}"
                                        HorizontalAlignment="Left" Margin="3,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource Accent}"/>
                                    <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="Thumb" Property="Background" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </CheckBox.Template>
                </CheckBox>
                <TextBlock Text="Only offline clusters" Foreground="{StaticResource TextPrimary}"
                           FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <!-- Clusters table -->
            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid Style="{StaticResource DarkDataGrid}"
                          ItemsSource="{Binding FilteredClusterRows}"
                          IsReadOnly="True" CanUserResizeRows="False">
                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Cluster name" Binding="{Binding Name}" Width="*" MinWidth="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="12,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="12,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Brokers count" Binding="{Binding BrokersCount}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="12,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Partitions" Binding="{Binding Partitions}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="12,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Topics" Binding="{Binding Topics}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="12,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Production" Binding="{Binding ProductionDisplay}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="12,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Consumption" Binding="{Binding ConsumptionDisplay}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Margin" Value="12,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
